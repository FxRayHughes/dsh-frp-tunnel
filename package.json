{
  "name": "@local/dsh-frp-tunnel",
  "version": "0.2.1",
  "private": true,
  "description": "Expose the DSH Web GUI through a self-hosted frps server via frpc.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "relay.js",
    "frpc.js",
    "mobile/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "test": "node test-relay.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
